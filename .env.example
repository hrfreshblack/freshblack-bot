# Токен Telegram-бота (обов'язково)
BOT_TOKEN=

# ОБОВ'ЯЗКОВО: рядок підключення до Postgres (Railway підставляє автоматично,
# якщо додати базу даних до проєкту і послатись на неї як
# ${{ Postgres.DATABASE_URL }} у Variables цього сервісу). Без цієї змінної
# бот не запуститься — див. docs/DEPLOYMENT.md.
DATABASE_URL=

# Порт, на якому слухає сервер. Railway часто підставляє свій — якщо не
# задано, використовується 3000.
PORT=3000

# URL Apps Script bridge (Веб-застосунок). Якщо не задано — використовується
# поточний URL, зашитий у коді, тож можна не чіпати цю змінну одразу.
APPS_SCRIPT_URL=

# Telegram user_id HRD та головного бухгалтера, і chat_id групи погоджень.
# Якщо не задано — використовуються поточні значення, зашиті в коді.
HRD_USER_ID=
ACCOUNTANT_USER_ID=
APPROVAL_CHAT_ID=

# Опційно: секретний токен для захисту вебхука від підробних запитів.
# Якщо залишити порожнім — перевірка вимкнена (поточна поведінка, нічого не
# зламається). Як увімкнути — див. docs/DEPLOYMENT.md.
WEBHOOK_SECRET=
