# Той самий Postgres, що й у бота (Railway підставляє автоматично, якщо
# послатись як ${{ Postgres.DATABASE_URL }} у Variables цього сервісу).
DATABASE_URL=

# Логін/пароль для входу на сторінку складу (Basic Auth браузера).
# Якщо залишити порожнім — сторінка відкрита без пароля (лише для першого
# локального тестування, не для реального використання).
WAREHOUSE_USER=
WAREHOUSE_PASSWORD=
